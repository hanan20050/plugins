        <div class="tmp-mr-4 mb-2" style="position: relative; top: 1px;">
          <a data-hovercard-type="commit" data-hovercard-url="/NEZNAMY/TAB/commit/63f9daf33404e1be0151d27f48ca4b8d4a41cc94/hovercard" href="/NEZNAMY/TAB/commit/63f9daf33404e1be0151d27f48ca4b8d4a41cc94" data-view-component="true" class="Link Link--muted"><svg aria-label="Commit" role="img" data-component="Octicon" height="16" viewBox="0 0 16 16" version="1.1" width="16" data-view-component="true" class="octicon octicon-git-commit">
    <path d="M11.93 8.5a4.002 4.002 0 0 1-7.86 0H.75a.75.75 0 0 1 0-1.5h3.32a4.002 4.002 0 0 1 7.86 0h3.32a.75.75 0 0 1 0 1.5Zm-1.43-.75a2.5 2.5 0 1 0-5 0 2.5 2.5 0 0 0 5 0Z"></path>
